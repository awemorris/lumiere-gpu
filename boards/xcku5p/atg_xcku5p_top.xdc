##
## HamGeek XCKU5P (xcku5p-ffvb676-2-i) timing and IO constraint skeleton.
## IMPORTANT: Physical PACKAGE_PIN and IOSTANDARD constraints below are
## intentionally left commented/unassigned until verified against the
## HamGeek XCKU5P carrier-board schematic and FMC HDMI adapter pinout.
## Never fabricate or guess pinouts.

## Primary 200 MHz differential oscillator (5.000 ns period)
create_clock -name sysclk -period 5.000 [get_ports sys_clk_p]
## PCIe Gen3 x4 100 MHz differential reference clock (10.000 ns period)
create_clock -name pcie_refclk -period 10.000 [get_ports pcie_refclk_p]
## UNVERIFIED / PENDING CARRIER SCHEMATIC:
## set_property -dict { PACKAGE_PIN <PIN_P> IOSTANDARD DIFF_SSTL12 } [get_ports sys_clk_p]
## set_property -dict { PACKAGE_PIN <PIN_N> IOSTANDARD DIFF_SSTL12 } [get_ports sys_clk_n]

## JTAG BSCANE2 TCK (30 MHz max)
create_clock -name tck -period 33.333 [get_pins -hier -filter {NAME =~ *jtag/bscan/TCK}]

## Asynchronous clock domain groups
set_clock_groups -asynchronous \
	-group [get_clocks -of_objects [get_pins -hier -filter {NAME =~ *clocks/mmcm_g/CLKOUT0}]] \
	-group [get_clocks -include_generated_clocks -of_objects [get_pins -hier -filter {NAME =~ *clocks/mmcm_g/CLKOUT1}]] \
	-group [get_clocks -of_objects [get_pins -hier -filter {NAME =~ *clocks/mmcm_g/CLKOUT2}]] \
	-group [get_clocks -include_generated_clocks pcie_refclk] \
	-group [get_clocks tck]

## Async board IOs
set_false_path -from [get_ports cpu_reset]
set_false_path -to [get_ports {led[*]}]
set_false_path -to [get_ports {iic_scl iic_sda iic_mux_reset_n}]
set_false_path -from [get_ports {iic_scl iic_sda}]
set_property IOB TRUE [get_ports {hdmi_d[*] hdmi_de hdmi_hs hdmi_vs}]
set_false_path -to [get_ports {hdmi_d[*] hdmi_de hdmi_hs hdmi_vs hdmi_clk}]

## UNVERIFIED / PENDING CARRIER SCHEMATIC: cpu_reset, led[7:0], iic_*, hdmi_*, pcie_*
## DDR4 pin constraints are generated by the atg_xcku5p_ddr4 IP and merged with
## carrier-board XDC LOCs when Kintex UltraScale+ build support is installed.
